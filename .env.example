# Server-only. Never prefix Cloudflare credentials with NEXT_PUBLIC_.
# Cloudflare dashboard -> Workers AI -> Use REST API -> Create a Workers AI API Token.
# Custom tokens require Workers AI: Read AND Workers AI: Edit, scoped to your account.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional signed anonymous-session secret. Defaults to the server's API token.
AI_SESSION_SECRET=

# Conservative request-attempt caps per Node process. Values can be lowered; max 60.
# These are app safeguards, not a distributed/account-level billing guarantee.
AI_DAILY_REQUEST_LIMIT=60
AI_VISITOR_DAILY_LIMIT=10
